<?xml version="1.0" encoding="utf-8"?>
<!--
    OpeyScaler tek renkli (monokrom) olcegi.
    Renk yerine derinlik: her yuzey bir onceki katmandan bir tik acilir,
    ayrimlar 1 px sac cizgileriyle yapilir. Vurgu rengi yoktur; secili oge
    beyaza doner ve zemin siyaha gecer.
-->
