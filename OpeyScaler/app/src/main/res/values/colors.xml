    <color name="ink">#FF050506</color>
    <color name="ink_raised">#FF0B0C0E</color>
    <color name="ink_card">#FF0F1013</color>
    <color name="ink_chip">#FF16171B</color>
    <color name="ink_press">#FF1D1F24</color>

    <!-- Sac cizgileri -->
    <color name="hairline">#FF1D1F23</color>
    <color name="hairline_strong">#FF2A2D33</color>

    <!-- Beyaz katmanlar -->
    <color name="paper">#FFF5F6F8</color>
    <color name="paper_soft">#FFC5C9CF</color>
    <color name="paper_dim">#FF8B9098</color>
    <color name="paper_faint">#FF5F646C</color>
    <color name="paper_ghost">#FF3A3E45</color>

    <!-- Beyazin saydam tonlari (vurgu ve parilti icin) -->
    <color name="glow_12">#1FFFFFFF</color>
    <color name="glow_08">#14FFFFFF</color>
    <color name="glow_04">#0AFFFFFF</color>
