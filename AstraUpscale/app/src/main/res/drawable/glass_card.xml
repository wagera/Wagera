<?xml version="1.0" encoding="utf-8"?>
<!--
    Cam panel.

    Uc katman: yari saydam 145 derece gecis, 1px sac cizgisi kenar ve ust
    kenarda yukaridan gelen bir isik cizgisi. Isik cizgisi panelin ustte
    bir kaynagi oldugunu ima eder; kalinligi 1px'tir, daha fazlasi kenarlik
    gibi gorunur.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="235"
                android:startColor="@color/glass_top"
                android:endColor="@color/glass_bottom"
                android:type="linear" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp" android:left="14dp" android:right="14dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_sheen" />
        </shape>
    </item>
</layer-list>
