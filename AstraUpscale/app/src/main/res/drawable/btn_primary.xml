<?xml version="1.0" encoding="utf-8"?>
<!-- Ana eylem: zemin beyaza doner, yazi siyah olur. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/content_soft" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/content" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
