<!--
    AstraUpscale isareti — durum cubugu surumu.

    Android durum cubugu simgelerini tek renge indirger; bu yuzden
    burada tint yoktur ve renk sabittir.

    Kroksuz bir "A": sol bacak kuculen basamaklarla iner, sag bacak duz bir
    diyagonaldir. Basamaklar isin oncesidir — piksel; duz kenar sonrasi —
    cozulmus. Yani isaret hem markanin harfi, hem uygulamanin yaptigi is.

    Onceki isaret dort kollu bir yildizdi. Kendi basina fena degildi ama
    ayirt edici degildi: her yapay zeka uygulamasi yildiz kullaniyor.

    Basamak sayisi 5'te sabitlendi. 200 pikselde ilerleme acikca okunuyor,
    36 pikselde siluet hala "A" olarak duruyor; 6 basamakta kucuk boyda
    basamaklar birbirine giriyor, 4'te ilerleme duygusu zayifliyor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Sag bacak: duz kenar -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M24,3.5 L43,44 L34,44 L24,16.5 Z" />

    <!-- Sol bacak: basamakli kenar -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M24,3.5 L20.2,3.5 L20.2,11.6 L16.4,11.6 L16.4,19.7 L12.6,19.7 L12.6,27.8 L8.8,27.8 L8.8,35.9 L5,35.9 L5,44 L14,44 L24,16.5 Z" />
</vector>
