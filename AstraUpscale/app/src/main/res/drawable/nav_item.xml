<?xml version="1.0" encoding="utf-8"?>
<!--
    Sekme.

    Secili sekme dolgu almaz; ustunde 2dp'lik bir sinyal cizgisi belirir.
    Bir aletin etkin kanalini gosterme bicimi budur — kapsul degil, isaret.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:gravity="top" android:height="2dp" android:left="14dp" android:right="14dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/signal" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
