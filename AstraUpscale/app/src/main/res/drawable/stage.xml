<?xml version="1.0" encoding="utf-8"?>
<!--
    Sahne: sayfanin tek odak alani. Bos durum, onizleme, ilerleme ve sonuc
    hepsi bu ayni dikdortgeni paylasir; alt alta yigilmazlar.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_low" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
    <!-- Ust kenardan gelen cok hafif isik: karanlik temada goruntulenir -->
    <item android:gravity="top" android:height="1dp" android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/sheen" />
        </shape>
    </item>
</layer-list>
