<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_press" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/hairline_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_chip" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
</selector>
