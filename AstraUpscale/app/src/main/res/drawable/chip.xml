<?xml version="1.0" encoding="utf-8"?>
<!--
    Cozunurluk ve bicim secicileri.

    Kural degismedi: secili oge icerik rengine boyanir, yazisi zemin
    rengine doner — bu kural iki temada da kendiliginden tersine doner.
    Secili olmayan durum artik cam diliyle ayni yuzeyi kullanir.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/content" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_press" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="235"
                android:startColor="@color/glass_top"
                android:endColor="@color/glass_bottom"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
