<?xml version="1.0" encoding="utf-8"?>
<!--
    Secici.

    Secili olan sinyal rengine boyanir, yazisi sinyal ustu renge doner.
    Secili olmayan yalnizca cizgidir. Onceki kural "secili oge icerik
    rengine boyanir" idi; sinyal rengi geldigi icin artik secim de
    sinyal tasiyor.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/signal" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_press" />
            <corners android:radius="@dimen/radius_chip" />
            <stroke android:width="1dp" android:color="@color/rule" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_chip" />
            <stroke android:width="1dp" android:color="@color/rule" />
        </shape>
    </item>
</selector>
