<?xml version="1.0" encoding="utf-8"?>
<!-- Uyari kutusu: sol kenarinda sinyal serit. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_low" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/rule" />
        </shape>
    </item>
    <item android:gravity="start" android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/signal" />
        </shape>
    </item>
</layer-list>
