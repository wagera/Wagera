<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="235"
                android:startColor="@color/glass_top"
                android:endColor="@color/glass_bottom"
                android:type="linear" />
            <corners android:radius="@dimen/radius_stage" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_sheen" />
        </shape>
    </item>
</layer-list>
