<?xml version="1.0" encoding="utf-8"?>
<!-- Model satiri: secili olan hafifce acilir, solunda beyaz bir cizgi belirir. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ink_chip" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:width="2dp" android:gravity="left|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/paper" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_raised" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
