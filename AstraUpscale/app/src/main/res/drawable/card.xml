<?xml version="1.0" encoding="utf-8"?>
<!-- Kart: koyu zemin, sac cizgisi cerceve ve ustten gelen cok hafif bir isik -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/sheen"
                android:centerColor="@color/sheen_soft"
                android:endColor="@android:color/transparent"
                android:type="linear" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
