<!--
    Panel.

    Alet dilinde yuzeyler saydamlikla degil CIZGIYLE ayrilir: opak dolgu,
    1 piksellik kesin kenar, 2dp yaricap. Onceki cam panelin 235 derecelik
    yari saydam gecisi, ust kenardaki isik cizgisi ve 14dp yaricapi
    kaldirildi — hepsi "yuzuyor" duygusu icindi, burada istenen "yerinde
    duruyor".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/radius_card" />
    <stroke android:width="1dp" android:color="@color/rule" />
</shape>
