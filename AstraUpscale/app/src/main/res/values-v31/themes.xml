<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 (API 31) ve ustu.

    Bu surumlerde sistem her uygulamaya kendi acilis ekranini uygular ve
    windowBackground yontemini yok sayar. Karsi koymak yerine sistemin
    kendi nitelikleriyle ayni isareti ve ayni zemini veriyoruz; boylece
    8.0'dan 15'e kadar acilis ayni gorunur.

    windowSplashScreenAnimatedIcon icin sistem 108x108'lik tuvalin ortadaki
    dairesine sigan bir cizim bekler; ic_launcher_foreground zaten bu
    olculere gore hizalanmistir.
-->
<resources>
    <style name="LaunchTheme" parent="@style/AppTheme">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
        <item name="android:statusBarColor">@color/launch_bg</item>
        <item name="android:navigationBarColor">@color/launch_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
