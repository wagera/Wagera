<?xml version="1.0" encoding="utf-8"?>
<!--
    AstraUpscale renk olcegi — AYDINLIK tema.

    Renk yerine derinlik: her yuzey bir onceki katmandan bir tik ayrilir,
    ayrimlar 1 px sac cizgileriyle yapilir. Vurgu rengi yoktur; secili oge
    "content" rengine boyanir ve yazisi "bg" rengine doner. Ayni kural karanlik
    temada kendiliginden tersine doner.
-->
<resources>
    <!-- Yuzeyler: sayfa zemininden yukari dogru -->
    <color name="bg">#FFF6F7F9</color>
    <color name="surface_low">#FFF0F1F4</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_high">#FFEDEEF2</color>
    <color name="surface_press">#FFE2E4EA</color>

    <!-- Sac cizgileri -->
    <color name="hairline">#FFE3E5EA</color>
    <color name="hairline_strong">#FFD3D6DD</color>

    <!-- Icerik: birincilden en sessize -->
    <color name="content">#FF14161C</color>
    <color name="content_soft">#FF3C414B</color>
    <color name="content_dim">#FF697079</color>
    <color name="content_faint">#FF8E949E</color>
    <color name="content_ghost">#FFB6BAC3</color>

    <!-- Kart ustundeki isik: aydinlik temada gorunmez -->
    <color name="sheen">#00FFFFFF</color>
    <color name="sheen_soft">#00FFFFFF</color>

    <!-- Dokunma parlamasi -->
    <color name="glow_12">#14000000</color>
    <color name="glow_08">#0D000000</color>

    <!-- Sahneyi orten katman: opak degil, alttaki fotograf sezilir -->
    <color name="scrim_fill">#F2F6F7F9</color>

    <!-- ══ Cam dili — acik temada kagit uzerinde ince bir tabaka ═══════ -->
    <color name="glass_top">#E6FFFFFF</color>
    <color name="glass_bottom">#F2F7F8FB</color>
    <color name="glass_stroke">#1F000000</color>
    <color name="glass_sheen">#00FFFFFF</color>
    <color name="glass_press">#FFE8EAF0</color>
    <color name="scrim_glass">#E6F4F5F8</color>
</resources>
