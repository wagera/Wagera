<?xml version="1.0" encoding="utf-8"?>
<!--
    AstraUpscale renk olcegi — AYDINLIK tema.

    Tasarim dili "cam"dan "alet"e gecti. Onceki dilde yuzeyler yari
    saydamdi, kenarlar yumusak, koseler genis yaricapliydi; her sey
    yuzuyormus gibi dururdu. Yenisinde yuzeyler opak, kenarlar 1 piksellik
    kesin cizgiler, koseler neredeyse dik. Amac bir olcum aletinin
    yuzu: yumusaklik degil kesinlik.

    Iki degisiklik butun gorunumu tasir:
      1. Cam ve bulaniklik yok. Yuzeyler birbirinden saydamlikla degil,
         cizgiyle ayrilir.
      2. Tek bir SINYAL rengi var. Onceki dilde vurgu rengi hic yoktu ve
         secili oge icerik rengine boyanirdi; artik secili ve birincil
         olan sinyal rengini alir. Tek renk, tek anlam: "etkin olan bu".
-->
<resources>
    <!-- Yuzeyler: sayfa zemininden yukari dogru -->
    <color name="bg">#FFF7F7F5</color>
    <color name="surface_low">#FFEFEFEC</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_high">#FFE6E6E2</color>
    <color name="surface_press">#FFDBDBD6</color>

    <!-- Cizgiler. Alet dilinde ayrimlar cizgiyle yapilir, golgeyle degil. -->
    <color name="rule">#FFD6D6D0</color>
    <color name="rule_strong">#FF2A2A28</color>
    <!-- Izgara cizgisi: sayfanin arkasindaki olcu agi -->
    <color name="grid">#14000000</color>

    <!-- Icerik: birincilden en sessize -->
    <color name="content">#FF14140F</color>
    <color name="content_soft">#FF3D3D37</color>
    <color name="content_dim">#FF6B6B63</color>
    <color name="content_faint">#FF91918A</color>
    <color name="content_ghost">#FFB8B8B1</color>

    <!--
        Sinyal rengi.

        Aydinlik temada koyu bir zeytin-yesili; karanlik temada ayni
        renk elektrik limonuna doner. Ikisi de ayni anlami tasir ama
        kendi zemininde okunur kalir: acik zeminde parlak limon
        gorunmez, koyu zeminde koyu zeytin gorunmez.
    -->
    <color name="signal">#FF4A5A00</color>
    <color name="signal_on">#FFF7F7F5</color>
    <color name="signal_dim">#FF8A9A3A</color>

    <color name="glow_12">#14000000</color>
    <color name="glow_08">#0D000000</color>
    <color name="notification_accent">#FF4A5A00</color>
    <color name="scrim_glass">#F2F7F7F5</color>
    <color name="launch_bg">#FF0A0A08</color>
</resources>
