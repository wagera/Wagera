<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/content</item>
        <item name="android:colorAccent">@color/content</item>
        <item name="android:colorControlNormal">@color/content_faint</item>
        <item name="android:colorControlActivated">@color/content</item>
        <item name="android:colorControlHighlight">@color/glow_12</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/content</item>
        <item name="android:textColorSecondary">@color/content_dim</item>
        <item name="android:textColorHint">@color/content_faint</item>
    </style>

    <!-- Bolum basliklari: kucuk, seyrek harfli, sessiz -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- Kart ici alt baslik -->
    <style name="TierLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- ══ Yeni yerlesim stilleri ═══════════════════════════════════════
         Her stil tek bir isi yapar; olculer dimens.xml olceginden gelir. -->

    <!-- Akordeon satirinin solundaki ad -->
    <style name="RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content</item>
        <item name="android:textSize">@dimen/text_row</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <!-- Akordeon satirinin sagindaki gecerli deger -->
    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_dim</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Acik panelin icindeki alt baslik -->
    <style name="PanelLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:letterSpacing">0.20</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- ══ Tipografi ═══════════════════════════════════════════════════
         Iki yuz: gosterim icin Space Grotesk, arayuz icin Manrope.
         Gosterim yuzu yalnizca buyuk baslikta ve sayisal okumalarda
         kullanilir; govde metninde fazla karakterli olur. -->

    <!-- Kahraman baslik: iki satir, siki harf araligi -->
    <style name="Display">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/content</item>
    </style>

    <!-- Baslik altindaki aciklama -->
    <style name="HeroCopy">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/content_dim</item>
    </style>

    <!-- Sayisal okuma: hedef cozunurluk, yuzde, olcu -->
    <style name="Readout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/content</item>
    </style>

    <!--
        Acilis temasi.

        Activity bu temayla baslar: pencere olusur olusmaz windowBackground
        cizilir, yani ilk kare hazirlanirken ekranda beyaz/siyah bir bosluk
        degil isaret durur. MainActivity.onCreate icinde setTheme ile asil
        temaya gecilir — bu satir setContentView'dan ONCE gelmeli, yoksa
        gorunumler acilis temasiyla sisirilir.
    -->
    <style name="LaunchTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:statusBarColor">@color/launch_bg</item>
        <item name="android:navigationBarColor">@color/launch_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ══ Kunye ═══════════════════════════════════════════════════════
         Alet dilinin satir dilbilgisi: solda etiket, sagda deger, altinda
         cizgi. Kart yok, golge yok, yaricap yok — yalnizca hizalama. -->

    <style name="SpecRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/row_height</item>
        <item name="android:background">@drawable/row_press</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/gutter</item>
        <item name="android:paddingEnd">@dimen/gutter</item>
    </style>

    <style name="SpecKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">@dimen/text_fine</item>
    </style>

    <style name="SpecValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/content</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="SpecChevron">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:src">@drawable/ic_chevron</item>
    </style>

    <style name="SpecRule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/rule</item>
    </style>

    <style name="SpecPanel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/surface_low</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/gutter</item>
        <item name="android:paddingEnd">@dimen/gutter</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="SpecNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">@dimen/text_fine</item>
    </style>

    <style name="SpecReadout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/content</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="SpecChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:fontFamily">@font/sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="SpecSeek">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxHeight">2dp</item>
        <item name="android:minHeight">2dp</item>
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:thumbOffset">2dp</item>
    </style>

    <!-- Alan etiketi: kucuk, seyrek, buyuk harf -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <!-- Olcegin altindaki kademe etiketi -->
    <style name="ScaleTick">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/content_ghost</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>
